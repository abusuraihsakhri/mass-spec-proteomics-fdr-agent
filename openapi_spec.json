{
  "openapi": "3.1.0",
  "info": {
    "title": "Mass Spec Proteomics FDR Agent — Legacy Alert API",
    "description": "Rule-based threshold and status flag evaluation; not PSM FDR analysis. Live OpenAPI schema is served at /openapi.json.",
    "version": "3.0.0-ENTERPRISE"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Service health",
        "responses": {
          "200": {
            "description": "JSON status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON task and audit counters",
        "responses": {
          "200": {
            "description": "JSON metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate legacy rule-based task",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ],
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  },
                  "attributes": {
                    "type": "object"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rule-based dossier with HMAC-linked audit metadata"
          },
          "422": {
            "description": "Invalid payload"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock supervisory response",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "query"
                ],
                "properties": {
                  "query": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mock status response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read signed audit metadata",
        "parameters": [
          {
            "name": "X-Audit-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Token configured with AUDIT_LOG_READ_TOKEN; access disabled if not configured"
          }
        ],
        "responses": {
          "200": {
            "description": "Audit metadata and signature verification result"
          },
          "403": {
            "description": "Access denied"
          }
        }
      }
    }
  }
}
